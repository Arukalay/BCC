# Скопируйте в .env и укажите ключ: cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore).

# Провайдер LLM: openai (основной, им сформирован отчёт) или gemini (бесплатный вариант)
LLM_PROVIDER=openai

# --- OpenAI ---
# Ключ: https://platform.openai.com/api-keys (нужен положительный баланс в Billing)
OPENAI_API_KEY=your_api_key_here
# Модель, которой сформирован отчёт. Список моделей на ключе: python -m validator --check-llm
OPENAI_MODEL=gpt-5.4-mini

# --- Gemini (бесплатно, без оплаты) ---
# Чтобы использовать: LLM_PROVIDER=gemini и ключ из https://aistudio.google.com/ -> Get API key
GEMINI_API_KEY=your_api_key_here
# Работает на бесплатном тарифе (проверено 27.11.2026). gemini-2.5-* недоступны новым ключам (404),
# а gemini-3.5-flash и новее дают на бесплатном тарифе 20 запросов в сутки (прогону нужно около 20).
GEMINI_MODEL=gemini-3.1-flash-lite
